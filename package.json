{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "A TypeScript OpenAI-compatible gateway with an embedded browser control panel",
  "type": "module",
  "bin": {
    "llm-gateway": "./dist/llm-gateway"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:gateway && npm run build:auth",
    "build:gateway": "npm run build:web && node scripts/build-native.mjs src/cli/main.ts dist/llm-gateway",
    "build:auth": "tsc -p tsconfig.auth.json",
    "build:web": "node scripts/prepare-ui.mjs",
    "start": "./dist/llm-gateway serve",
    "dev": "npm run build && npm run start",
    "desktop": "./dist/llm-gateway desktop",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "doctor": "./dist/llm-gateway doctor",
    "models": "./dist/llm-gateway models",
    "export:harness": "./dist/llm-gateway export deepseek-harness",
    "auth": "npm run build:auth && node dist/auth/scripts/auth.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "format": "biome format --write web/src",
    "format:check": "biome format web/src",
    "lint": "biome lint web/src",
    "check:frontend": "biome check web/src"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@perryts/perry": "0.5.1520",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "openai": "^7.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "eventsource-parser": "^3.1.1",
    "hono": "^4.13.7"
  }
}
