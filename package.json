{
  "name": "llm-gateway",
  "version": "1.3.3",
  "description": "A Rust/Tauri OpenAI-compatible gateway with a React control panel",
  "type": "module",
  "scripts": {
    "build": "npm run build:web:tauri && npm run build:auth",
    "build:auth": "tsc -p tsconfig.auth.json",
    "dev:web:tauri": "vite --config web/vite.config.ts --host 127.0.0.1 --port 1420",
    "build:web:tauri": "vite build --config web/vite.config.ts",
    "serve:headless": "cargo run --manifest-path src-tauri/Cargo.toml -- --headless",
    "serve:rust": "npm run serve:headless",
    "desktop": "tauri dev",
    "package:tauri": "tauri build",
    "package:macos": "tauri build --bundles app,dmg",
    "auth": "npm run build:auth && node dist/auth/scripts/auth.js",
    "sync": "npm run build:auth && node dist/auth/scripts/sync.js",
    "sync:push": "npm run sync -- push",
    "sync:pull": "npm run sync -- pull",
    "sync:status": "npm run sync -- status",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:auth": "npm run build:auth && node --test dist/auth/scripts/auth-support.test.js",
    "test:frontend": "vitest run",
    "test:release": "node --test scripts/prepare-release.test.mjs",
    "typecheck": "tsc -p tsconfig.auth.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "format": "biome format --write web/src web/tests vitest.config.ts",
    "format:check": "biome format web/src web/tests vitest.config.ts",
    "lint": "biome lint web/src web/tests vitest.config.ts",
    "check:frontend": "biome check web/src web/tests vitest.config.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2.11.1",
    "eventsource-parser": "^4.1.1",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "zod": "^3.25.76"
  }
}
