# Rust/Tauri 网关配置
PORT=3000
BIND_HOST=127.0.0.1
# HEADLESS=1
# PROXY_API_KEY=change-me
# PROXY_ADMIN_KEY=admin-change-me
REQUEST_TIMEOUT_MS=180000
# HTTP JSON 请求体字节上限（默认 8 MiB，与模型 token 上下文限制无关）
MAX_BODY_BYTES=8388608
# CORS_ORIGIN=http://localhost:1420
RUNTIME_DIR=./.runtime
# AUTH_CACHE_DIR=./.runtime/auth
# DATABASE_FILE=./.runtime/gateway.sqlite3
MODEL_DISCOVERY=true
MODEL_DISCOVERY_TIMEOUT_MS=30000
# 可选：显式提供 WorkBuddy 模型目录，远程发现失败时使用
# WORKBUDDY_MODEL_FILE=/path/to/workbuddy-models.json
# MODEL_ALLOWLIST=model-a,model-b
# DEFAULT_MODEL=provider/model-id
# METRICS_MAX_RECORDS=2000
# CHANNELS_FILE=./.runtime/channels.json
# API_KEYS_FILE=./.runtime/api-keys.json
# VITE_SYNC_URL=https://sync.example.com
# SYNC_URL=https://sync.example.com
# SYNC_TOKEN=worker-sync-token
# SYNC_VAULT_ID=personal
# SYNC_PASSPHRASE=use-a-long-local-passphrase

# 一次性认证工具（仅 npm run auth 使用）
MITM_COMMAND=mitmweb
MITM_PROXY_HOST=127.0.0.1
MITM_PROXY_PORT=8080
MITM_WEB_HOST=127.0.0.1
MITM_WEB_PORT=8081
MITM_WEB_PASSWORD=123456
# MITM_URL=http://127.0.0.1:8081/flows
# MITM_AUTH=Bearer 123456
AUTH_TIMEOUT_MS=120000
# CLIENT_BIN=/path/to/client
# CLIENT_ARGS_JSON=["--some-client-flag"]
# CLIENT_IGNORE_CERT_ERRORS=true
# MITM_CA_CERT=/path/to/mitmproxy-ca-cert.pem
CLIENT_PROXY_BYPASS=<local>;127.0.0.1;localhost
