# ── 网关配置（运行时只读取这一组）────────────────────────────
PORT=3000
BIND_HOST=127.0.0.1
# PROXY_API_KEY=change-me
# PROXY_ADMIN_KEY=admin-change-me
REQUEST_TIMEOUT_MS=180000
MAX_BODY_BYTES=1048576
# CORS_ORIGIN=http://localhost:3000

# 运行目录；认证和模型缓存会按 Provider 分目录保存
RUNTIME_DIR=./.runtime
# 桌面托盘图标（可选，支持 PNG / ICNS / ICO）
# TRAY_ICON_PATH=/path/to/llm-gateway.png
# macOS 默认浏览器 Bundle ID（可选；用于从托盘启动时显式切到浏览器）
# BROWSER_BUNDLE_ID=com.google.Chrome
# 远程连接模式：只监测和打开此网关，不创建或停止本地服务
# GATEWAY_URL=https://gateway.example.com
# “启动时打开控制台”可在托盘菜单切换，偏好保存于 RUNTIME_DIR/desktop-preferences.json
# 桌面日志位于 RUNTIME_DIR/logs/desktop.log（自动轮换）
# AUTH_CACHE_DIR=./.runtime/auth
# MODEL_CACHE_DIR=./.runtime/models
# 默认先读 ~/.workbuddy/cache/acc-product-config-v3.json，macOS 安装包配置作为兜底
# 显式指定的有效模型文件优先于上述默认来源
# WORKBUDDY_MODEL_FILE=/path/to/WorkBuddy/product.json
MODEL_DISCOVERY=true
MODEL_CACHE_TTL_MS=300000
# MODEL_DISCOVERY_TIMEOUT_MS=30000
# MODEL_ALLOWLIST=model-a,model-b
# DEFAULT_MODEL=provider/model-id
# RESPONSE_STORE_MAX_ENTRIES=128
# RESPONSE_STORE_TTL_MS=3600000
# RESPONSE_STORE_MAX_BYTES=8388608
# CHANNELS_FILE=./.runtime/channels.json
# API_KEYS_FILE=./.runtime/api-keys.json
# METRICS_FILE=./.runtime/metrics.json
# METRICS_MAX_RECORDS=2000

# ── 一次性认证工具配置（仅 npm run auth 使用）───────────────
# 认证工具会自动启动 mitmweb 和对应桌面客户端，完成后退出；同时为客户端注入
# Chromium 代理参数和 HTTP(S)_PROXY 环境变量，供 Electron/Node 网络请求使用。
MITM_COMMAND=mitmweb
MITM_PROXY_HOST=127.0.0.1
MITM_PROXY_PORT=8080
MITM_WEB_HOST=127.0.0.1
MITM_WEB_PORT=8081
MITM_WEB_PASSWORD=123456
# MITM_URL=http://127.0.0.1:8081/flows
# MITM_AUTH=Bearer 123456
AUTH_TIMEOUT_MS=120000

# 不设置时自动探测各 Provider 的桌面客户端入口（WorkBuddy 默认探测 Electron）
# CLIENT_BIN=/path/to/client
# CLIENT_ARGS_JSON=["--some-client-flag"]
# 客户端无法信任 mitmproxy CA 时可临时启用（仅建议本机调试）
# CLIENT_IGNORE_CERT_ERRORS=true
# 默认自动使用 ~/.mitmproxy/mitmproxy-ca-cert.pem；证书位置特殊时覆盖
# MITM_CA_CERT=/path/to/mitmproxy-ca-cert.pem
CLIENT_PROXY_BYPASS=<local>;127.0.0.1;localhost
