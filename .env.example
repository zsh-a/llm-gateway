# 监听端口与地址（默认仅本机访问）
PORT=3000
BIND_HOST=127.0.0.1

# 可选：保护本地代理接口；不设置则保持兼容旧行为
# MIMO_PROXY_API_KEY=change-me

# 可选：限制浏览器跨域来源；默认 *
# CORS_ORIGIN=http://localhost:3000

# 可选：请求超时和请求体上限
REQUEST_TIMEOUT_MS=180000
MAX_BODY_BYTES=1048576

# 方式 1: 直接指定已登录的 Cookie（若配置，可脱离客户端与 mitmproxy 独立运行）
# MIMO_COOKIE=passToken=...; userId=...; serviceToken=...
# MIMO_COOKIE_FILE=./cookie.txt

# 方式 2: 通过本地 mitmproxy 动态自动获取（默认配置）
# 统一启动器会自动启动 mitmweb；直接运行 mimo-server 时仍需手动启动
MIMO_AUTH_MODE=auto
# 首次从 mitmproxy 获取到认证后持久化到该文件；401/403 时自动删除
MIMO_AUTH_CACHE_FILE=./.runtime/auth.json
MIMO_AUTO_START_MITM=true
MITM_COMMAND=mitmweb
MITM_PROXY_HOST=127.0.0.1
MITM_PROXY_PORT=8080
MITM_WEB_HOST=127.0.0.1
MITM_WEB_PORT=8081
MITM_WEB_PASSWORD=123456
MITM_URL=http://127.0.0.1:8081/flows
MITM_AUTH=Bearer 123456

# 认证流匹配规则；可用逗号配置多个客户端/上游
MIMO_AUTH_HOSTS=mimo-server-cn.xiaomimimo.com
MIMO_AUTH_PATHS=/api/route/chat/completions
MIMO_CAPTURE_HEADERS=cookie,authorization,x-*

# 模型列表：默认从 MiMo Desktop 的 /api/model/list 动态获取
MIMO_MODEL_DISCOVERY=true
# MIMO_MODEL_LIST_URL=https://mimo-server-cn.xiaomimimo.com/api/model/list
# 使用官方 https://api.xiaomimimo.com/v1/models 时填写 API Key
# MIMO_MODEL_API_KEY=...
MODEL_CACHE_TTL_MS=300000
MIMO_MODEL_CACHE_FILE=./.runtime/models.json

# 统一启动器（--desktop 或 MIMO_AUTO_START_DESKTOP=true 时启用）
MIMO_CLIENT_BIN=/Applications/Xiaomi MiMo.app/Contents/MacOS/Xiaomi MiMo
# MIMO_CLIENT_ARGS_JSON=["--some-client-flag"]
MIMO_AUTO_START_DESKTOP=false
MIMO_CLIENT_PROXY_BYPASS=<local>;127.0.0.1;localhost
RUNTIME_LOG_DIR=./.runtime

# CLI 的 Chrome DevTools JSON 地址
CDP_JSON_URL=http://127.0.0.1:9222/json
