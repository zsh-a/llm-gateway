# ── 网关配置（运行时只读取这一组）────────────────────────────
PORT=3000
BIND_HOST=127.0.0.1
# PROXY_API_KEY=change-me
REQUEST_TIMEOUT_MS=180000
MAX_BODY_BYTES=1048576
# CORS_ORIGIN=http://localhost:3000

# 运行目录；认证和模型缓存会按 Provider 分目录保存
RUNTIME_DIR=./.runtime
# AUTH_CACHE_DIR=./.runtime/auth
# MODEL_CACHE_DIR=./.runtime/models
MODEL_DISCOVERY=true
MODEL_CACHE_TTL_MS=300000
# MODEL_ALLOWLIST=model-a,model-b
# DEFAULT_MODEL=provider/model-id

# ── 一次性认证工具配置（仅 npm run auth 使用）───────────────
# 认证工具会自动启动 mitmweb 和对应桌面客户端，完成后退出；同时为客户端注入
# Chromium 代理参数和 HTTP(S)_PROXY 环境变量，兼容 Electron/Node 网络请求。
MITM_COMMAND=mitmweb
MITM_PROXY_HOST=127.0.0.1
MITM_PROXY_PORT=8080
MITM_WEB_HOST=127.0.0.1
MITM_WEB_PORT=8081
MITM_WEB_PASSWORD=123456
# MITM_URL=http://127.0.0.1:8081/flows
# MITM_AUTH=Bearer 123456
AUTH_TIMEOUT_MS=120000

# 不设置时自动探测各 Provider 的桌面客户端入口（WorkBuddy 默认探测 Electron）
# CLIENT_BIN=/path/to/client
# CLIENT_ARGS_JSON=["--some-client-flag"]
# 客户端无法信任 mitmproxy CA 时可临时启用（仅建议本机调试）
# CLIENT_IGNORE_CERT_ERRORS=true
# 默认自动使用 ~/.mitmproxy/mitmproxy-ca-cert.pem；证书位置特殊时覆盖
# MITM_CA_CERT=/path/to/mitmproxy-ca-cert.pem
CLIENT_PROXY_BYPASS=<local>;127.0.0.1;localhost
