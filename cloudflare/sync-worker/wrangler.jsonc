{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-gateway-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "observability": { "enabled": true },
  "secrets": { "required": ["SYNC_TOKEN"] },
  "durable_objects": {
    "bindings": [
      { "name": "VAULT", "class_name": "VaultObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VaultObject"] }
  ]
}
