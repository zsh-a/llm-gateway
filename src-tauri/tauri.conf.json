{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Gateway",
  "version": "1.1.1",
  "identifier": "com.llmgateway.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web:tauri",
    "beforeBuildCommand": "npm run build:web:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../.build/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LLM Gateway",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://[::1]:*; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
